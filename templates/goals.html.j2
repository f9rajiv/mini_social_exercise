{% extends "base.html.j2" %}
{% block content %}
{# Weekly contribution goal page - Chapter 2, Design Claims 13 & 15 #}

<div class="col-md-8 mx-auto">
  <h2 class="text-center border-bottom pb-2 mb-4"><span>My Weekly Goal</span></h2>

  {% if progress %}
    <div class="mb-4">
      {% with goal_progress=progress %}
        {% include "partials/goal_widget.html.j2" %}
      {% endwith %}
    </div>
  {% endif %}

  <!-- Set / change goal -->
  <div class="card shadow-sm mb-4">
    <div class="card-body">
      <h5 class="card-title">{% if progress %}Change your goal{% else %}Set a goal for this week{% endif %}</h5>
      <p class="text-muted small">
        Specific, challenging goals lead to more contribution than "do your best".
        Our suggestion is one more than your best week so far:
        <strong>{{ suggested_goal.posts_target }} posts</strong> and
        <strong>{{ suggested_goal.comments_target }} comments</strong>.
      </p>
      <form action="{{ url_for('goals') }}" method="POST" class="row g-3 align-items-end">
        <div class="col-sm-4">
          <label for="posts_target" class="form-label">Posts per week</label>
          <input type="number" class="form-control" id="posts_target" name="posts_target"
                 min="{{ limits.posts[0] }}" max="{{ limits.posts[1] }}" required
                 value="{{ progress.posts_target if progress else suggested_goal.posts_target }}">
        </div>
        <div class="col-sm-4">
          <label for="comments_target" class="form-label">Comments per week</label>
          <input type="number" class="form-control" id="comments_target" name="comments_target"
                 min="{{ limits.comments[0] }}" max="{{ limits.comments[1] }}" required
                 value="{{ progress.comments_target if progress else suggested_goal.comments_target }}">
        </div>
        <div class="col-sm-4">
          <button type="submit" class="btn btn-primary w-100">Save goal</button>
        </div>
      </form>
      {% if progress %}
      <form action="{{ url_for('delete_goal') }}" method="POST" class="mt-3"
            onsubmit="return confirm('Remove your weekly goal?');">
        <button type="submit" class="btn btn-link text-danger p-0">Remove goal</button>
      </form>
      {% endif %}
    </div>
  </div>

  <!-- History: feedback on past weeks against the current goal -->
  {% if history %}
  <div class="card shadow-sm">
    <div class="card-body">
      <h5 class="card-title">Previous weeks</h5>
      <table class="table table-sm mb-0">
        <thead>
          <tr><th>Week of</th><th>Posts</th><th>Comments</th><th>Goal met?</th></tr>
        </thead>
        <tbody>
          {% for week in history %}
          <tr>
            <td>{{ week.week_start.strftime('%b %d, %Y') }}</td>
            <td>{{ week.posts_done }} / {{ progress.posts_target }}</td>
            <td>{{ week.comments_done }} / {{ progress.comments_target }}</td>
            <td>{% if week.met %}<span class="text-success">Yes</span>{% else %}<span class="text-muted">No</span>{% endif %}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
  {% endif %}
</div>
{% endblock %}
